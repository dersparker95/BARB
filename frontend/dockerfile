# =============================================================================
# ETAPA DE CONSTRUCCIÓN
# =============================================================================
#
# Instala dependencias y genera el build de producción del frontend.
#

FROM node:22-alpine AS builder
WORKDIR /app

# Copia únicamente los manifiestos de dependencias primero, para que Docker
# reutilice la capa de instalación mientras no cambien.
COPY package.json package-lock.json ./
RUN npm install

COPY . .
RUN npm run build

# =============================================================================
# ETAPA DE SERVICIO
# =============================================================================
#
# Sirve el build generado mediante Nginx.
#

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
